    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.1.1",
    "firebase-functions": "^5.0.1",
    "sib-api-v3-sdk": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.20",
    "typescript": "^5"
  },
  "private": true
}
